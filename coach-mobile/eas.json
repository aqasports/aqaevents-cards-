      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ERP_BASE_URL": "https://delightful-torte-bcca6a.netlify.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
