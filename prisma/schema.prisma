generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "sqlite"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("staff")
  createdAt    DateTime @default(now())

  ledgerEntries LedgerEntry[]
  redemptions   Redemption[]
  auditLogs     AuditLog[]
}

model Client {
  id        String   @id @default(cuid())
  fullName  String
  email     String?
  phone     String?
  notes     String?
  archived   Boolean  @default(false)
  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CRM Fields
  leadSource       String?
  customerSegment  String    @default("Standard")
  totalSpent       Int       @default(0)
  lastActivityDate DateTime?
  favoriteActivity String?

  // Organization Fields
  organizationId String?
  orgRole        String?
  departmentId   String?

  // Marketing & Attribution Fields
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  leadAttribution    String?

  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  department       Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  cards            Card[]
  ledgerEntries    LedgerEntry[]
  redemptions      Redemption[]
  invoices         Invoice[]
  notificationLogs NotificationLog[]
  checkIns         CheckIn[]
  publicPurchaseRequests PublicPurchaseRequest[]
  waitlists        SessionWaitlist[]

  @@index([departmentId])
}

model Card {
  id          String   @id @default(cuid())
  clientId    String? // null = pre-printed blank, not yet assigned to a client
  publicToken String   @unique
  cardCode    String   @unique
  status      String   @default("active") // active | voided
  issuedAt    DateTime @default(now())

  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]
  publicPurchaseRequests PublicPurchaseRequest[]

  @@index([clientId])
}

model Package {
  id           String   @id @default(cuid())
  name         String
  creditAmount Int // Activities the client pays for
  bonusCredits Int      @default(0) // Free bonus activities added on top
  totalCredits Int // Computed: creditAmount + bonusCredits
  price        Int // creditAmount × 1900
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  ledgerEntries LedgerEntry[]
}

model Activity {
  id            String   @id @default(cuid())
  name          String
  description   String?
  creditCost    Float    @default(1.0)
  imageUrl      String?
  places        String?
  duration      String? // e.g. "2h", "Half day", "Full day"
  gallery       String? // JSON: [{type:"image"|"video", url:string, caption:string?}]
  equipment     String? // JSON: [{name:string, type:"rent"|"buy"|"provided", price:number?}]
  active        Boolean  @default(true)
  eventType     String   @default("fixed")
  requiresCheck Boolean  @default(false) // Whether club check-in scanning is required
  clubId        String?
  club          Club?    @relation(fields: [clubId], references: [id], onDelete: SetNull)
  checkIns      CheckIn[]
  createdAt     DateTime @default(now())

  sessions    ActivitySession[]
  redemptions Redemption[]
  expenses    ActivityExpense[]
}

model ActivityExpense {
  id         String   @id @default(cuid())
  activityId String
  name       String
  amount     Int
  notes      String?
  createdAt  DateTime @default(now())

  activity        Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sessionExpenses SessionExpense[]

  @@index([activityId])
}

model ActivitySession {
  id               String   @id @default(cuid())
  activityId       String
  sessionDate      DateTime
  location         String?
  capacity         Int?
  active           Boolean  @default(true)
  clubId           String?  // Optional: club assigned to host/check this session
  coachId          String?  // Optional: coach assigned to lead this session
  coachPayOverride Int?     // Optional: override DA payout for this session
  maxCapacity      Int?     // Optional max capacity for waitlisting
  createdAt        DateTime @default(now())

  activity        Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  club            Club?            @relation(fields: [clubId], references: [id], onDelete: SetNull)
  coach           Coach?           @relation(fields: [coachId], references: [id], onDelete: SetNull)
  redemptions     Redemption[]
  sessionExpenses SessionExpense[]
  checkIns        CheckIn[]
  equipmentUsages EquipmentUsage[]
  waitlists       SessionWaitlist[]

  @@index([activityId])
  @@index([sessionDate])
  @@index([clubId])
  @@index([coachId])
}

model SessionExpense {
  id                String   @id @default(cuid())
  sessionId         String
  activityExpenseId String
  quantity          Float    @default(1.0)
  amount            Int      // Stored calculated amount (e.g. quantity * unitPrice or override amount)
  createdAt         DateTime @default(now())

  session         ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  activityExpense ActivityExpense @relation(fields: [activityExpenseId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([activityExpenseId])
}

model LedgerEntry {
  id           String   @id @default(cuid())
  clientId     String
  cardId       String?
  packageId    String?
  redemptionId String?
  delta        Float
  type         String
  reason       String?
  createdById  String?
  createdAt    DateTime @default(now())

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  card       Card?       @relation(fields: [cardId], references: [id], onDelete: SetNull)
  package    Package?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  redemption Redemption? @relation(fields: [redemptionId], references: [id], onDelete: Cascade)
  createdBy  AdminUser?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([createdAt])
}

model Redemption {
  id          String   @id @default(cuid())
  clientId    String
  activityId  String
  sessionId   String?
  creditsUsed Float    @default(1.0)
  staffId     String?
  redeemedAt  DateTime @default(now())
  notes       String?

  client        Client           @relation(fields: [clientId], references: [id], onDelete: Restrict)
  activity      Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  session       ActivitySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  staff         AdminUser?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]
  checkIns      CheckIn[]

  @@index([clientId])
  @@index([redeemedAt])
}

model Invoice {
  id             String            @id @default(cuid())
  clientId       String
  organizationId String?
  invoiceCode    String            @unique
  amount         Int
  status         String            @default("paid")
  category       String            @default("package")
  items          String
  notes          String?
  paidAt         DateTime?
  poNumber       String?
  dueDate        DateTime?
  taxRate        Float             @default(19)
  createdAt      DateTime          @default(now())

  client       Client              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  lineItems    InvoiceLineItem[]

  @@index([clientId])
  @@index([organizationId])
  @@index([createdAt])
  @@index([status])
}

model Organization {
  id                     String             @id @default(cuid())
  name                   String
  slug                   String             @unique
  creditRate             Float?
  sharedCreditPool       Float              @default(0)
  useSharedPool          Boolean            @default(false)
  contactName            String?
  contactEmail           String?
  contactPhone           String?
  billingAddress         String?
  nif                    String?
  nis                    String?
  rc                     String?
  defaultPaymentTermDays Int?
  discountTier           String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  clients                Client[]
  invoices               Invoice[]
  users                  OrganizationUser[]
  contracts              Contract[]
  departments            Department[]
  aiActionQueues         AiActionQueue[]
}

model OrganizationUser {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String?
  magicToken     String?      @unique
  magicTokenExp  DateTime?
  role           String       @default("VIEWER")
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
}

model Contract {
  id             String       @id @default(cuid())
  organizationId String
  startDate      DateTime
  endDate        DateTime?
  creditRate     Float?
  discountTier   String?
  autoRenew      Boolean      @default(false)
  expiryPolicy   String       @default("rollover")
  status         String       @default("draft")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([status])
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  budgetCap      Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients        Client[]

  @@index([organizationId])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Float    @default(1)
  unitPrice   Int
  taxRate     Float    @default(19)
  lineTotal   Int
  createdAt   DateTime @default(now())

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Coach {
  id             String            @id @default(cuid())
  name           String
  email          String?           @unique
  phone          String?           @unique
  specialties    String?
  defaultPayRate Int               @default(0)
  commissionRate Float             @default(0)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  sessions       ActivitySession[]
}

model EquipmentAsset {
  id               String           @id @default(cuid())
  name             String
  category         String
  purchasePrice    Int              @default(0)
  purchaseDate     DateTime         @default(now())
  usefulLifeMonths Int              @default(36)
  maintenanceCost  Int              @default(0)
  status           String           @default("available")
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  usageLogs        EquipmentUsage[]
}

model EquipmentUsage {
  id               String           @id @default(cuid())
  equipmentAssetId String
  sessionId        String?
  loggedAt         DateTime         @default(now())
  notes            String?

  equipmentAsset EquipmentAsset   @relation(fields: [equipmentAssetId], references: [id], onDelete: Cascade)
  session        ActivitySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([equipmentAssetId])
  @@index([sessionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // e.g. "RESET_DATA", "CREATE_PACKAGE", "DELETE_ACTIVITY"
  target    String // Target description
  details   String? // Detail info
  ipAddress String?
  createdAt DateTime @default(now())

  user AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model NotificationLog {
  id        String   @id @default(cuid())
  clientId  String
  type      String // "sms" | "email"
  recipient String // target phone or email
  subject   String?
  message   String
  status    String // "sent" | "failed"
  sentAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([sentAt])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Int
  description String?
  imageUrl    String?
  advertised  Boolean  @default(true)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CardDemand {
  id               String   @id @default(cuid())
  name             String
  phone            String
  email            String?  // Optional email
  creditType       String   // "package" or "custom"
  packageId        String?
  amount           Int?     // For custom credits
  price            Int      // Computed price in DA (Algerian Dinars)
  status           String   @default("pending") // "pending", "accepted", "rejected"
  cardCode         String?  // Linked physical card code (e.g. AQA-989734)
  marketingConsent Boolean  @default(false)
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  referrer         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ActivityProposal {
  id               String   @id @default(cuid())
  title            String
  description      String
  userName         String
  userPhone        String
  userEmail        String?
  status           String   @default("pending") // "pending", "reviewed", "archived"
  marketingConsent Boolean  @default(false)
  utmSource        String?
  utmMedium        String?
  utmCampaign      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model CampaignPromo {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    // "percentage" or "fixed"
  discountValue Float     // e.g. 20.0 for 20%, 500.0 for 500 DA
  maxUses       Int?
  usesCount     Int       @default(0)
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model AiActionQueue {
  id              String        @id @default(cuid())
  actionType      String
  proposedPayload String
  reasoning       String
  status          String        @default("pending") // "pending", "approved", "rejected"
  reviewedBy      String?
  reviewedAt      DateTime?
  executedAt      DateTime?
  organizationId  String?
  targetEntityId  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([organizationId])
}

model SessionWaitlist {
  id        String          @id @default(cuid())
  sessionId String
  clientId  String
  status    String          @default("waiting") // "waiting", "notified", "cancelled", "promoted"
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  session ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  client  Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([clientId])
  @@index([status])
}

// ─── Club Check-In System ────────────────────────────────────────────────────

model Club {
  id            String   @id @default(cuid())
  name          String
  logoUrl       String?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  terminalToken String   @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  activities    Activity[]
  sessions      ActivitySession[]
  checkIns      CheckIn[]
}

model CheckIn {
  id           String        @id @default(cuid())
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  activityId   String
  activity     Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  sessionId    String?
  session      ActivitySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  clubId       String
  club         Club          @relation(fields: [clubId], references: [id], onDelete: Cascade)
  redemptionId String?
  redemption   Redemption?   @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  status       String        @default("SUCCESS")
  scannedAt    DateTime      @default(now())
  scannedIp    String?

  @@index([clubId, scannedAt])
  @@index([clientId, activityId])
}

model PublicPurchaseRequest {
  id               String   @id @default(cuid())
  cardId           String
  clientId         String
  type             String   // "package" | "custom" | "product"
  payload          String   // JSON string of purchase payload
  status           String   @default("pending_confirmation") // "pending_confirmation" | "confirmed" | "expired" | "rejected"
  confirmationCode String
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([clientId])
  @@index([confirmationCode])
}

model RateLimitBucket {
  key         String    @id
  count       Int
  windowStart DateTime
  lockUntil   DateTime?
}

model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}



